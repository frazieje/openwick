/*
 * Candle wiring on the SparkFun Pro nRF52840 Mini headers.
 *
 * Everything in this file is project wiring (what we solder to the headers);
 * the board files only describe what SparkFun put on the PCB.
 *
 *   Header pin  Signal   What                      Peripheral
 *   P0.19       flame0   amber 5 mm                PWM0 ch0
 *   P0.20       flame1   yellow 5 mm               PWM0 ch1
 *   P0.21       flame2   red 5 mm                  PWM0 ch2
 *   P0.15       flame3   mini LED cluster          PWM0 ch3
 *   P0.22       rgb_r    RGB LED red               PWM1 ch0
 *   P0.23       rgb_g    RGB LED green             PWM1 ch1
 *   P0.17       rgb_b    RGB LED blue              PWM1 ch2
 *   P0.28       vbatt    battery divider (AIN4)    SAADC
 *
 * The four flame channels are low-side 2N3904 switches: GPIO high = LED on,
 * so their PWM polarity is "normal". The RGB LED is common cathode, so its
 * three elements are switched on the high side by 2N3906 PNPs: GPIO low =
 * element on, hence PWM_POLARITY_INVERTED on those channels. A 10 k from each
 * PNP base to 3V3 keeps the core dark while the pins float during reset.
 *
 * PWM period 500 us = 2 kHz, which gives 8000 counts of resolution on the
 * nRF52840's 16 MHz PWM clock (plenty for gamma-corrected low-end dimming).
 */

#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-adc.h>

#define CANDLE_PWM_PERIOD PWM_USEC(500)

/ {
	flame_leds: pwmleds_flame {
		compatible = "pwm-leds";

		flame0: flame_0 {
			pwms = <&pwm0 0 CANDLE_PWM_PERIOD PWM_POLARITY_NORMAL>;
			label = "Flame 0 amber";
		};
		flame1: flame_1 {
			pwms = <&pwm0 1 CANDLE_PWM_PERIOD PWM_POLARITY_NORMAL>;
			label = "Flame 1 yellow";
		};
		flame2: flame_2 {
			pwms = <&pwm0 2 CANDLE_PWM_PERIOD PWM_POLARITY_NORMAL>;
			label = "Flame 2 red";
		};
		flame3: flame_3 {
			pwms = <&pwm0 3 CANDLE_PWM_PERIOD PWM_POLARITY_NORMAL>;
			label = "Flame 3 cluster";
		};
	};

	rgb_leds: pwmleds_rgb {
		compatible = "pwm-leds";

		rgb_r: rgb_r {
			pwms = <&pwm1 0 CANDLE_PWM_PERIOD PWM_POLARITY_INVERTED>;
			label = "RGB red";
		};
		rgb_g: rgb_g {
			pwms = <&pwm1 1 CANDLE_PWM_PERIOD PWM_POLARITY_INVERTED>;
			label = "RGB green";
		};
		rgb_b: rgb_b {
			pwms = <&pwm1 2 CANDLE_PWM_PERIOD PWM_POLARITY_INVERTED>;
			label = "RGB blue";
		};
	};

	/* Two 1 M resistors from the battery "+" pad to GND, midpoint to P0.28,
	 * with 100 nF from the midpoint to GND.
	 */
	vbatt: vbatt {
		compatible = "voltage-divider";
		io-channels = <&adc 4>;
		output-ohms = <1000000>;
		full-ohms = <(1000000 + 1000000)>;
	};
};

&pinctrl {
	pwm0_default: pwm0_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 19)>,
				<NRF_PSEL(PWM_OUT1, 0, 20)>,
				<NRF_PSEL(PWM_OUT2, 0, 21)>,
				<NRF_PSEL(PWM_OUT3, 0, 15)>;
		};
	};

	pwm0_sleep: pwm0_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 19)>,
				<NRF_PSEL(PWM_OUT1, 0, 20)>,
				<NRF_PSEL(PWM_OUT2, 0, 21)>,
				<NRF_PSEL(PWM_OUT3, 0, 15)>;
			low-power-enable;
		};
	};

	pwm1_default: pwm1_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 22)>,
				<NRF_PSEL(PWM_OUT1, 0, 23)>,
				<NRF_PSEL(PWM_OUT2, 0, 17)>;
		};
	};

	pwm1_sleep: pwm1_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 22)>,
				<NRF_PSEL(PWM_OUT1, 0, 23)>,
				<NRF_PSEL(PWM_OUT2, 0, 17)>;
			low-power-enable;
		};
	};
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

&pwm1 {
	status = "okay";
	pinctrl-0 = <&pwm1_default>;
	pinctrl-1 = <&pwm1_sleep>;
	pinctrl-names = "default", "sleep";
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;

	/* Battery divider: 0..2.1 V into AIN4, 1/6 gain against the 0.6 V
	 * internal reference gives a 3.6 V full scale. The 1 M source impedance
	 * needs the long 40 us acquisition time.
	 */
	channel@4 {
		reg = <4>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN4>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <4>;
	};
};
